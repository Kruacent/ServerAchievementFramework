# Database Configuration
DB_HOST=db   # MySQL server address (leave as 127.0.0.1 if on the same machine)
DB_USER=            # Your MySQL username
DB_PASSWORD=        # Password for the MySQL user
DB_DATABASE=        # Database name
DB_PORT=3307        # Default MySQL port

# Steam Web API key, to show Steam names and avatars (optional).
# Get one at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Server Configuration
SERVER_PORT=5000    # Leave as 5000