# Database name and accounts. They are only read when the database is first
# created: changing them later does not change an existing database.
# The game plugin connects with DB_USER / DB_PASSWORD too.
DB_ROOT_PASSWORD=change-me-root
DB_DATABASE=SAFSql
DB_USER=SAFUser
DB_PASSWORD=change-me

STEAM_API_KEY=

WEB_PORT=3000

# Where MySQL and the API listen
DB_BIND=127.0.0.1
DB_PORT=3307
API_BIND=127.0.0.1
API_PORT=5000